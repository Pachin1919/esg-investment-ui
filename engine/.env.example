# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Moonshot (Kimi) API key: primary model kimi-k3 for the scorer, reviewer and source finders (src/esgx/llm.py).
MOONSHOT_API_KEY=

# Anthropic API key: optional second rater (claude-* model ids).
ANTHROPIC_API_KEY=

# Required for Organization-scoped keys: Console > Organization settings > Workspaces > (workspace) > ID.
# Leave empty for a workspace-scoped key.
ANTHROPIC_WORKSPACE_ID=

# SEC EDGAR requires a descriptive User-Agent with contact info on every request.
ESGX_SEC_USER_AGENT=esgx research bot your.email@example.com
